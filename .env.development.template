# SLAM25 Members Area - Development Environment Template
# Copy this file to .env.development and update the values for your development setup

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
VITE_DEV_URL=http://localhost:5173
VITE_ALT_URL=http://localhost:5174
VITE_API_URL=http://localhost:3005/api
VITE_SERVER_URL=http://localhost:3005
VITE_WS_URL=http://localhost:3005

# Development-specific ports for hot reloading
DEV_PORTS=5173,5174,5178

# =============================================================================
# ADMIN CONFIGURATION
# =============================================================================
# Admin participant limit for dropdowns/selectors (no pagination)
VITE_ADMIN_PARTICIPANTS_LIMIT=1000

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL Database Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=slam25_db
DB_USER=slam_user
DB_PASSWORD=slam25_secure_password_2025

# Database Connection Pool Settings (Development)
DB_MAX_CONNECTIONS=10
DB_MIN_CONNECTIONS=2
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000
DB_ACQUIRE_TIMEOUT=10000
DB_STATEMENT_TIMEOUT=30000
DB_QUERY_TIMEOUT=30000

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
# JWT Secret for token generation (CHANGE IN PRODUCTION!)
JWT_SECRET=your_development_jwt_secret_key_here_change_this_in_production

# Session Configuration
SESSION_SECRET=your_development_session_secret_here_change_this_in_production
SESSION_MAX_AGE=86400000
SESSION_HTTP_ONLY=true
SESSION_SECURE=false
SESSION_SAME_SITE=lax

# Cookie Configuration
COOKIE_SECRET=your_development_cookie_secret_here_change_this_in_production
COOKIE_MAX_AGE=86400000
COOKIE_HTTP_ONLY=true
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Log Level (error, warn, info, debug)
LOG_LEVEL=debug

# Log File Paths
LOG_DIR=./logs
AUDIT_LOG_FILE=./logs/audit.log
ERROR_LOG_FILE=./logs/error.log
COMBINED_LOG_FILE=./logs/combined.log
PERFORMANCE_LOG_FILE=./logs/performance.log
SECURITY_LOG_FILE=./logs/security.log

# =============================================================================
# CORS & SECURITY
# =============================================================================
# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5178

# Security Headers
HELMET_CSP_ENABLED=false
HELMET_HSTS_ENABLED=false

# Rate Limiting (Development - More Permissive)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=true

# =============================================================================
# WEBSOCKET CONFIGURATION
# =============================================================================
# Socket.io Settings
SOCKET_IO_CORS_ORIGIN=http://localhost:5173
SOCKET_IO_TRANSPORTS=websocket,polling
SOCKET_IO_TIMEOUT=20000

# =============================================================================
# CACHING CONFIGURATION
# =============================================================================
# Cache Settings (Development)
CACHE_TTL=300000
CACHE_MAX_SIZE=100
CACHE_CLEANUP_INTERVAL=600000

# =============================================================================
# PERFORMANCE MONITORING
# =============================================================================
# Performance Logging
PERFORMANCE_LOGGING_ENABLED=true
PERFORMANCE_SLOW_QUERY_THRESHOLD=1000
PERFORMANCE_LOG_INTERVAL=60000

# =============================================================================
# DEVELOPMENT TOOLS
# =============================================================================
# Hot Reloading
HOT_RELOAD_ENABLED=true
VITE_HMR_PORT=5173

# Debug Mode
DEBUG_MODE=true
DEBUG_SQL=false
DEBUG_WEBSOCKET=false

# =============================================================================
# ERROR TRACKING (Sentry - optional in dev)
# =============================================================================
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
# Backup Settings
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7
BACKUP_SCHEDULE=0 2 * * *

# =============================================================================
# TIMEZONE CONFIGURATION
# =============================================================================
# Default Timezone
DEFAULT_TIMEZONE=Europe/Berlin
TIMEZONE_API_URL=https://worldtimeapi.org/api/timezone

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
# External API Configuration
EXTERNAL_API_TIMEOUT=10000
EXTERNAL_API_RETRIES=3

# =============================================================================
# DEVELOPMENT-SPECIFIC OVERRIDES
# =============================================================================
# Development Database (Optional - for testing)
DEV_DB_NAME=slam25_dev_db
DEV_DB_USER=slam_dev_user
DEV_DB_PASSWORD=slam25_dev_password

# Development Admin User (Auto-created)
DEV_ADMIN_EMAIL=admin@slam25.com
DEV_ADMIN_PASSWORD=admin123
DEV_ADMIN_NAME=Development Admin

# =============================================================================
# FEATURE FLAGS (Development)
# =============================================================================
# Feature Toggles
FEATURE_WEBSOCKET_ENABLED=true
FEATURE_CACHING_ENABLED=true
FEATURE_PERFORMANCE_MONITORING=true
FEATURE_DEBUG_LOGGING=true
FEATURE_HOT_RELOAD=true

# =============================================================================
# TESTING CONFIGURATION
# =============================================================================
# Test Database
TEST_DB_NAME=slam25_test_db
TEST_DB_USER=slam_test_user
TEST_DB_PASSWORD=slam25_test_password

# Test Configuration
TEST_TIMEOUT=10000
TEST_RETRIES=3
