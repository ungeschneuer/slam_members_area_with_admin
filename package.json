{
  "name": "slam25-members-area",
  "version": "1.0.0",
  "description": "SLAM25 Poetry Slam Members Area - Full Stack Application",
  "private": true,
  "type": "module",
  "main": "server/server.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite --config client/vite.config.js",
    "dev:server": "nodemon",
    "dev:clean": "rm -rf node_modules/.vite && npm run dev",
    "start": "node server/server.js",
    "start:production": "node scripts/startup-checks.js && node server/server.js",
    "restart": "node scripts/restart-server.js --restart",
    "restart:complete": "node scripts/restart-complete.js --restart",
    "stop": "lsof -ti:3005 | xargs kill -9 2>/dev/null || echo 'No processes found on port 3005'",
    "check-port": "node scripts/check-port.js",
    "build": "npm run build:client",
    "build:client": "vite build --config client/vite.config.js",
    "preview": "vite preview --config client/vite.config.js",
    "load-test": "node scripts/load-test.js",
    "load-test:report": "node scripts/load-test.js --report",
    "prebuild": "node scripts/inject-version.js && node scripts/validate-imports.js",
    "monitor": "node scripts/monitor-server.js",
    "validate-imports": "node scripts/validate-imports.js",
    "export-db": "./scripts/export-database.sh",
    "package-uploads": "./scripts/package-uploads.sh",
    "deploy": "./deploy-unified.sh",
    "deploy:clean": "./deploy-unified.sh --clean",
    "deploy:incremental": "./deploy-unified.sh --incremental",
    "verify-deployment": "./scripts/verify-deployment.sh",
    "verify-uberspace-binding": "./scripts/verify-uberspace-binding.sh",
    "migrate": "./scripts/run-migrations.sh",
    "migrate:dry-run": "./scripts/run-migrations.sh --dry-run",
    "migrate:status": "./scripts/migration-status.sh",
    "migrate:rollback": "./scripts/rollback-migration.sh",
    "test:css-cache": "node scripts/test-css-cache-invalidation.js"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.2",
    "@sentry/node": "^8.55.0",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-query-devtools": "^5.90.2",
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-error-boundary": "^6.0.0",
    "react-hook-form": "7.64.0",
    "react-hot-toast": "^2.6.0",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "uuid": "^13.0.0",
    "xss": "^1.0.14",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "autocannon": "^7.12.0",
    "autoprefixer": "^10.4.15",
    "concurrently": "^8.2.2",
    "node-fetch": "^3.3.2",
    "nodemon": "^3.0.2",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.3",
    "terser": "^5.44.0",
    "vite": "^6.0.0"
  },
  "keywords": [
    "poetry-slam",
    "members-area",
    "full-stack",
    "react",
    "express",
    "postgresql"
  ],
  "author": "SLAM25 Development Team",
  "license": "MIT"
}
