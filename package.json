{
  "name": "slam25-members-area",
  "version": "1.0.0",
  "description": "SLAM25 Poetry Slam Members Area - Full Stack Application",
  "private": true,
  "type": "module",
  "main": "server/server.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite --config client/vite.config.js",
    "dev:server": "nodemon",
    "dev:clean": "rm -rf node_modules/.vite && npm run dev",
    "start": "node server/server.js",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --config client/vite.config.js",
    "build:server": "echo 'Server build complete - using source files directly'",
    "preview": "vite preview --config client/vite.config.js",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "test:ui": "vitest --ui",
    "prebuild": "node scripts/inject-version.js",
    "dev:fix": "npm run dev:clean",
    "migrate": "node server/scripts/migrate.js",
    "seed": "node server/scripts/seed.js"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.2",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-query-devtools": "^5.90.2",
    "bcrypt": "^5.1.1",
    "clsx": "^2.1.1",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "file-saver": "^2.0.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "morgan": "^1.10.0",
    "node-fetch": "^3.3.2",
    "pg": "^8.16.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-error-boundary": "^6.0.0",
    "react-hook-form": "7.64.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.3.1",
    "winston": "^3.10.0",
    "xlsx": "^0.18.5",
    "xss": "^1.0.14",
    "zod": "4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/plugin-transform-modules-commonjs": "^7.27.1",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.15",
    "babel-jest": "^30.1.2",
    "concurrently": "^8.2.2",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.1.2",
    "jsdom": "^27.0.0",
    "nodemon": "^3.0.2",
    "postcss": "^8.4.31",
    "supertest": "^6.3.3",
    "tailwindcss": "^3.3.3",
    "terser": "^5.44.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "poetry-slam",
    "members-area",
    "full-stack",
    "react",
    "express",
    "postgresql"
  ],
  "author": "SLAM25 Development Team",
  "license": "MIT"
}
