{
  "name": "slam25-members-area",
  "version": "1.0.0",
  "description": "SLAM25 Poetry Slam Members Area - Full Stack Application",
  "private": true,
  "type": "module",
  "main": "server/server.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite --config client/vite.config.js",
    "dev:server": "nodemon",
    "dev:clean": "rm -rf node_modules/.vite && npm run dev",
    "start": "node server/server.js",
    "start:production": "node scripts/startup-checks.js && node server/server.js",
    "restart": "node scripts/restart-server.js --restart",
    "stop": "lsof -ti:3005 | xargs kill -9 2>/dev/null || echo 'No processes found on port 3005'",
    "check-port": "node scripts/check-port.js",
    "build": "npm run build:client",
    "build:client": "vite build --config client/vite.config.js",
    "preview": "vite preview --config client/vite.config.js",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "test:ui": "vitest --ui",
    "load-test": "node scripts/load-test.js",
    "load-test:report": "node scripts/load-test.js --report",
    "prebuild": "node scripts/inject-version.js",
    "monitor": "node scripts/monitor-server.js",
    "verify-crawler-protection": "node scripts/verify-crawler-protection.js"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.2",
    "@sentry/node": "^8.55.0",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-query-devtools": "^5.90.2",
    "bcrypt": "^5.1.1",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "node-fetch": "^3.3.2",
    "pg": "^8.16.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-error-boundary": "^6.0.0",
    "react-hook-form": "7.64.0",
    "react-hot-toast": "^2.6.0",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "uuid": "^13.0.0",
    "winston": "^3.10.0",
    "xlsx": "^0.18.5",
    "xss": "^1.0.14",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "autocannon": "^7.12.0",
    "autoprefixer": "^10.4.15",
    "concurrently": "^8.2.2",
    "jsdom": "^27.0.0",
    "node-fetch": "^3.3.2",
    "nodemon": "^3.0.2",
    "postcss": "^8.4.31",
    "supertest": "^6.3.3",
    "tailwindcss": "^3.3.3",
    "terser": "^5.44.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "poetry-slam",
    "members-area",
    "full-stack",
    "react",
    "express",
    "postgresql"
  ],
  "author": "SLAM25 Development Team",
  "license": "MIT"
}
