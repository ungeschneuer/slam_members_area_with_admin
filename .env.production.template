# SLAM25 Members Area - Production Environment Template
# Copy this file to .env.production and update the values for your production setup
# IMPORTANT: Change all default passwords and secrets in production!

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://szene.slam25.de
VITE_DEV_URL=https://szene.slam25.de
VITE_ALT_URL=https://szene.slam25.de

# Production-specific configuration
APP_NAME=SLAM25 Members Area
APP_VERSION=1.0.0
APP_DESCRIPTION=SLAM25 Poetry Slam Members Area

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL Database Settings (Production)
DB_HOST=your_production_db_host
DB_PORT=5432
DB_NAME=slam25_prod_db
DB_USER=slam_prod_user
DB_PASSWORD=CHANGE_THIS_TO_SECURE_PRODUCTION_PASSWORD

# Database Connection Pool Settings (Production - Optimized)
DB_MAX_CONNECTIONS=50
DB_MIN_CONNECTIONS=5
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000
DB_ACQUIRE_TIMEOUT=10000
DB_STATEMENT_TIMEOUT=30000
DB_QUERY_TIMEOUT=30000

# Database SSL Configuration (Production)
DB_SSL_ENABLED=true
DB_SSL_REJECT_UNAUTHORIZED=false

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
# JWT Secret for token generation (MUST BE CHANGED!)
JWT_SECRET=CHANGE_THIS_TO_VERY_SECURE_JWT_SECRET_KEY_AT_LEAST_64_CHARACTERS_LONG

# Session Configuration (Production Security)
SESSION_SECRET=CHANGE_THIS_TO_VERY_SECURE_SESSION_SECRET_KEY_AT_LEAST_64_CHARACTERS_LONG
SESSION_MAX_AGE=86400000
SESSION_HTTP_ONLY=true
SESSION_SECURE=true
SESSION_SAME_SITE=strict

# Cookie Configuration (Production Security)
COOKIE_SECRET=CHANGE_THIS_TO_VERY_SECURE_COOKIE_SECRET_KEY_AT_LEAST_64_CHARACTERS_LONG
COOKIE_MAX_AGE=86400000
COOKIE_HTTP_ONLY=true
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Log Level (error, warn, info, debug)
LOG_LEVEL=info

# Log File Paths (Production)
LOG_DIR=/var/log/slam25
AUDIT_LOG_FILE=/var/log/slam25/audit.log
ERROR_LOG_FILE=/var/log/slam25/error.log
COMBINED_LOG_FILE=/var/log/slam25/combined.log
PERFORMANCE_LOG_FILE=/var/log/slam25/performance.log
SECURITY_LOG_FILE=/var/log/slam25/security.log

# Log Rotation
LOG_MAX_SIZE=10m
LOG_MAX_FILES=30
LOG_DATE_PATTERN=YYYY-MM-DD

# =============================================================================
# CORS & SECURITY
# =============================================================================
# CORS Origins (Production - Restrictive)
CORS_ORIGINS=https://szene.slam25.de

# Security Headers (Production - Strict)
HELMET_CSP_ENABLED=true
HELMET_HSTS_ENABLED=true
HELMET_HSTS_MAX_AGE=31536000
HELMET_HSTS_INCLUDE_SUBDOMAINS=true
HELMET_HSTS_PRELOAD=true

# Rate Limiting (Production - Strict)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false

# =============================================================================
# WEBSOCKET CONFIGURATION
# =============================================================================
# Socket.io Settings (Production)
SOCKET_IO_CORS_ORIGIN=https://szene.slam25.de
SOCKET_IO_TRANSPORTS=websocket,polling
SOCKET_IO_TIMEOUT=20000

# =============================================================================
# CACHING CONFIGURATION
# =============================================================================
# Cache Settings (Production - Optimized)
CACHE_TTL=300000
CACHE_MAX_SIZE=1000
CACHE_CLEANUP_INTERVAL=300000

# =============================================================================
# PERFORMANCE MONITORING
# =============================================================================
# Performance Logging (Production)
PERFORMANCE_LOGGING_ENABLED=true
PERFORMANCE_SLOW_QUERY_THRESHOLD=500
PERFORMANCE_LOG_INTERVAL=300000

# Monitoring and Alerting
MONITORING_ENABLED=true
ALERT_EMAIL=admin@slam25.de
ALERT_SLACK_WEBHOOK=your_slack_webhook_url

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
# Backup Settings (Production)
BACKUP_DIR=/var/backups/slam25
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *
BACKUP_ENCRYPTION_KEY=your_backup_encryption_key

# =============================================================================
# TIMEZONE CONFIGURATION
# =============================================================================
# Default Timezone
DEFAULT_TIMEZONE=Europe/Berlin
TIMEZONE_API_URL=https://worldtimeapi.org/api/timezone

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
# External API Configuration
EXTERNAL_API_TIMEOUT=5000
EXTERNAL_API_RETRIES=3

# Email Configuration (Optional)
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_SECURE=false

# =============================================================================
# SSL/TLS CONFIGURATION
# =============================================================================
# SSL Certificate Paths
SSL_CERT_PATH=/path/to/ssl/cert.pem
SSL_KEY_PATH=/path/to/ssl/private.key
SSL_CA_PATH=/path/to/ssl/ca.pem

# =============================================================================
# FEATURE FLAGS (Production)
# =============================================================================
# Feature Toggles (Production)
FEATURE_WEBSOCKET_ENABLED=true
FEATURE_CACHING_ENABLED=true
FEATURE_PERFORMANCE_MONITORING=true
FEATURE_DEBUG_LOGGING=false
FEATURE_HOT_RELOAD=false

# =============================================================================
# PRODUCTION-SPECIFIC SETTINGS
# =============================================================================
# Process Management
PM2_ENABLED=true
PM2_INSTANCES=max
PM2_MAX_MEMORY_RESTART=1G

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000

# Graceful Shutdown
GRACEFUL_SHUTDOWN_TIMEOUT=30000

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# Security Headers
SECURITY_HEADERS_ENABLED=true
SECURITY_HEADERS_HSTS_MAX_AGE=31536000
SECURITY_HEADERS_CSP_REPORT_URI=/api/security/csp-report

# Input Validation
INPUT_VALIDATION_ENABLED=true
INPUT_VALIDATION_STRICT_MODE=true

# =============================================================================
# MONITORING & ANALYTICS
# =============================================================================
# Application Monitoring
APM_ENABLED=false
APM_SERVICE_NAME=slam25-members-area
APM_SERVICE_VERSION=1.0.0

# Error Tracking
ERROR_TRACKING_ENABLED=false
ERROR_TRACKING_DSN=your_error_tracking_dsn

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================
# Deployment Environment
DEPLOYMENT_ENV=production
DEPLOYMENT_REGION=eu-central-1
DEPLOYMENT_VERSION=1.0.0

# Container Configuration (if using Docker)
CONTAINER_NAME=slam25-members-area
CONTAINER_PORT=3000
CONTAINER_HEALTH_CHECK=/health

# =============================================================================
# MAINTENANCE MODE
# =============================================================================
# Maintenance Mode Configuration
MAINTENANCE_MODE_ENABLED=false
MAINTENANCE_MODE_MESSAGE=System is under maintenance. Please try again later.
MAINTENANCE_MODE_ALLOWED_IPS=127.0.0.1,::1

# =============================================================================
# BACKUP & RECOVERY
# =============================================================================
# Backup Configuration
BACKUP_ENABLED=true
BACKUP_FREQUENCY=daily
BACKUP_COMPRESSION=true
BACKUP_ENCRYPTION=true

# Disaster Recovery
DR_ENABLED=false
DR_BACKUP_LOCATION=your_dr_backup_location
DR_RECOVERY_TIME_OBJECTIVE=4h
DR_RECOVERY_POINT_OBJECTIVE=1h
