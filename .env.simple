# SLAM25 Simple Environment Configuration
# Copy this to .env and update with your values

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
NODE_ENV=development
PORT=3005

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=slam25_db
DB_USER=slam_user
DB_PASSWORD=your_password_here

# Database Connection Pool Settings (optional)
DB_MAX_CONNECTIONS=10
DB_MIN_CONNECTIONS=2
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000
DB_ACQUIRE_TIMEOUT=10000
DB_STATEMENT_TIMEOUT=30000
DB_QUERY_TIMEOUT=30000

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
JWT_SECRET=your_jwt_secret_here_change_this_in_production_minimum_64_characters_required
SESSION_SECRET=your_session_secret_here_change_this_in_production_minimum_64_characters_required

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
# Frontend URLs (for CORS)
FRONTEND_URL=http://localhost:5173
VITE_DEV_URL=http://localhost:5173
VITE_ALT_URL=http://localhost:5174
VITE_API_URL=http://localhost:3005/api

# Development ports for CORS
DEV_PORTS=5173,5174,5178

# Admin Configuration
VITE_ADMIN_PARTICIPANTS_LIMIT=1000

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=info

# =============================================================================
# ERROR TRACKING (Sentry - optional)
# =============================================================================
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
