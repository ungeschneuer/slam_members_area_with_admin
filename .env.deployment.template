# SLAM25 Deployment Environment Template
# Copy this file to .env.deployment and fill in the values
# NEVER commit .env.deployment to version control

# Uberspace Configuration
UBERSPACE_USER=your_uberspace_username
UBERSPACE_HOST=your_uberspace_host.uber.space

# Project Configuration
PROJECT_NAME=slam25
DOMAIN=szene.slam25.de
PORT=47180

# Database Configuration (REQUIRED)
DB_USER=your_database_user
DB_PASSWORD=your_secure_database_password

# JWT Secrets (will be generated if not provided)
JWT_SECRET=your_64_character_jwt_secret_here
JWT_REFRESH_SECRET=your_64_character_refresh_secret_here
SESSION_SECRET=your_64_character_session_secret_here

# Optional: Override defaults
# NODE_ENV=production
# APP_TIMEZONE=Europe/Berlin
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=slam25_szene

# Database Connection Pool Settings (optional)
# Defaults: max=15, min=3 for production
# Adjust based on your Uberspace plan and application load
# DB_MAX_CONNECTIONS=15
# DB_MIN_CONNECTIONS=3
# DB_IDLE_TIMEOUT=300000
# DB_CONNECTION_TIMEOUT=20000
# DB_ACQUIRE_TIMEOUT=60000
