# SLAM25 Production Environment Configuration
# IMPORTANT: Change all secrets before deploying to production!

# Application
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://your-domain.com

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=slam25_db
DB_USER=slam_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_2025

# Database Connection Pooling
DB_MAX_CONNECTIONS=100
DB_MIN_CONNECTIONS=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=10000
DB_ACQUIRE_TIMEOUT=60000
DB_CREATE_TIMEOUT=30000
DB_DESTROY_TIMEOUT=5000
DB_REAP_INTERVAL=1000
DB_CREATE_RETRY_INTERVAL=200
DB_STATEMENT_TIMEOUT=30000
DB_QUERY_TIMEOUT=30000

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DB=0

# Security Configuration
JWT_SECRET=CHANGE_ME_SUPER_SECRET_JWT_KEY_2025
JWT_REFRESH_SECRET=CHANGE_ME_SUPER_SECRET_REFRESH_KEY_2025
SESSION_SECRET=CHANGE_ME_SESSION_SECRET_KEY_2025

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=300000
RATE_LIMIT_ADMIN_MAX=50
RATE_LIMIT_ADMIN_WINDOW_MS=300000
RATE_LIMIT_UPLOAD_MAX=10
RATE_LIMIT_UPLOAD_WINDOW_MS=60000
RATE_LIMIT_SEARCH_MAX=20
RATE_LIMIT_SEARCH_WINDOW_MS=60000

# Backup Configuration
BACKUP_DIR=/app/backups
MAX_BACKUPS=30
BACKUP_COMPRESSION=true
BACKUP_ENCRYPTION=true
BACKUP_ENCRYPTION_KEY=CHANGE_ME_BACKUP_ENCRYPTION_KEY

# GDPR Compliance
GDPR_ANONYMIZATION=true
GDPR_AUDIT_LOGGING=true
DATA_RETENTION_DAYS=2555

# Monitoring Configuration
LOG_LEVEL=info
LOG_SENSITIVE_DATA=false
MONITORING_ENABLED=true
ALERTING_ENABLED=true

# SSL/TLS Configuration
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem
SSL_REDIRECT=true

# CORS Configuration
CORS_ORIGIN=https://your-domain.com
CORS_CREDENTIALS=true

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Email Configuration (for notifications)
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your-email@your-domain.com
SMTP_PASSWORD=CHANGE_ME_EMAIL_PASSWORD
SMTP_FROM=noreply@your-domain.com

# Push Notifications
VAPID_PUBLIC_KEY=CHANGE_ME_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=CHANGE_ME_VAPID_PRIVATE_KEY
VAPID_SUBJECT=mailto:your-email@your-domain.com

# External Services
GOOGLE_MAPS_API_KEY=CHANGE_ME_GOOGLE_MAPS_API_KEY
ANALYTICS_ID=CHANGE_ME_ANALYTICS_ID

# Performance Configuration
CACHE_TTL=300
CACHE_MAX_SIZE=1000
COMPRESSION_ENABLED=true
COMPRESSION_LEVEL=6

# Security Headers
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true
CSP_REPORT_URI=https://your-domain.com/csp-report

# Database Backup
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_NOTIFICATION_EMAIL=admin@your-domain.com

# Monitoring
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true
ELASTICSEARCH_ENABLED=true
KIBANA_ENABLED=true

# Logging
LOG_FORMAT=json
LOG_ROTATION=true
LOG_MAX_SIZE=100MB
LOG_MAX_FILES=10

# Health Checks
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3

# Load Balancing
LOAD_BALANCER_ENABLED=false
STICKY_SESSIONS=false
SESSION_AFFINITY=false

# Auto-scaling
AUTO_SCALE_ENABLED=false
MIN_INSTANCES=1
MAX_INSTANCES=5
SCALE_UP_THRESHOLD=80
SCALE_DOWN_THRESHOLD=20

# Disaster Recovery
DR_ENABLED=false
DR_BACKUP_LOCATION=s3://your-backup-bucket
DR_RESTORE_TIMEOUT=3600

# Compliance
SOC2_ENABLED=false
HIPAA_ENABLED=false
PCI_DSS_ENABLED=false
ISO27001_ENABLED=false





