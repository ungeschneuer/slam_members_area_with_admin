# SLAM25 Members Area - Environment Template
# Copy this file to .env and update the values for your specific environment
# This is a general template that can be customized for any environment

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
NODE_ENV=development
PORT=3005
FRONTEND_URL=http://localhost:5173
VITE_DEV_URL=http://localhost:5173
VITE_ALT_URL=http://localhost:5174
VITE_API_URL=http://localhost:3005/api
VITE_SERVER_URL=http://localhost:3005
VITE_WS_URL=http://localhost:3005

# Development-specific ports for hot reloading
DEV_PORTS=5173,5174,5178

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL Database Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=slam25_db
DB_USER=slam_user
DB_PASSWORD=slam25_secure_password_2025

# Database Connection Pool Settings
DB_MAX_CONNECTIONS=20
DB_MIN_CONNECTIONS=5
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000
DB_ACQUIRE_TIMEOUT=10000
DB_STATEMENT_TIMEOUT=30000
DB_QUERY_TIMEOUT=30000

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
# JWT Secret for token generation (CHANGE IN PRODUCTION!)
JWT_SECRET=your_jwt_secret_key_here_change_this_in_production

# Session Configuration
SESSION_SECRET=your_session_secret_here_change_this_in_production
SESSION_MAX_AGE=86400000
SESSION_HTTP_ONLY=true
SESSION_SECURE=false
SESSION_SAME_SITE=lax

# Cookie Configuration
COOKIE_SECRET=your_cookie_secret_here_change_this_in_production
COOKIE_MAX_AGE=86400000
COOKIE_HTTP_ONLY=true
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Log Level (error, warn, info, debug)
LOG_LEVEL=info

# Log File Paths
LOG_DIR=./logs
AUDIT_LOG_FILE=./logs/audit.log
ERROR_LOG_FILE=./logs/error.log
COMBINED_LOG_FILE=./logs/combined.log
PERFORMANCE_LOG_FILE=./logs/performance.log
SECURITY_LOG_FILE=./logs/security.log

# =============================================================================
# ADMIN CONFIGURATION
# =============================================================================
# Admin participant limit for dropdowns/selectors (no pagination)
VITE_ADMIN_PARTICIPANTS_LIMIT=1000

# =============================================================================
# CORS & SECURITY
# =============================================================================
# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5178

# Security Headers
HELMET_CSP_ENABLED=false
HELMET_HSTS_ENABLED=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=true

# =============================================================================
# NOTE: WebSocket and advanced caching features removed
# This project uses simple polling for real-time updates (see polling.js)
# =============================================================================

# =============================================================================
# PERFORMANCE MONITORING
# =============================================================================
# Performance Logging
PERFORMANCE_LOGGING_ENABLED=true
PERFORMANCE_SLOW_QUERY_THRESHOLD=1000
PERFORMANCE_LOG_INTERVAL=60000

# =============================================================================
# DEVELOPMENT TOOLS
# =============================================================================
# Hot Reloading
HOT_RELOAD_ENABLED=true
VITE_HMR_PORT=5173

# Debug Mode
DEBUG_MODE=true
DEBUG_SQL=false
DEBUG_WEBSOCKET=false

# =============================================================================
# ERROR TRACKING (Sentry)
# =============================================================================
# Sentry DSN for error monitoring (optional)
SENTRY_DSN=
# Sampling rate for Sentry performance traces (0.0 - 1.0)
SENTRY_TRACES_SAMPLE_RATE=0.05

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
# Backup Settings
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7
BACKUP_SCHEDULE=0 2 * * *

# =============================================================================
# TIMEZONE CONFIGURATION
# =============================================================================
# Application Timezone (used by server/services/timezoneService.js)
APP_TIMEZONE=Europe/Berlin
TZ=Europe/Berlin
TIMEZONE_API_URL=https://worldtimeapi.org/api/timezone

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
# Backup Directory
BACKUP_DIR=./backups

# =============================================================================
# NOTES FOR PRODUCTION
# =============================================================================
# IMPORTANT: Before deploying to production:
# 1. Change all *_SECRET variables to strong, unique values
# 2. Set NODE_ENV=production
# 3. Set SESSION_SECURE=true and COOKIE_SECURE=true (requires HTTPS)
# 4. Set DB_PASSWORD to a strong password
# 5. Configure SENTRY_DSN for error tracking
# 6. Review and adjust DB_MAX_CONNECTIONS based on your hosting
# 7. Set appropriate CORS_ORIGINS for your domain
