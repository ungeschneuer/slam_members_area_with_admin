// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Users & Authentication
model User {
  id                String    @id @default(cuid())
  email             String    @unique
  username          String    @unique
  passwordHash      String
  firstName         String
  lastName          String
  pronouns          String?
  avatarUrl         String?
  bio               String?
  dateOfBirth       DateTime?
  phone             String?
  isActive          Boolean   @default(true)
  isVerified        Boolean   @default(false)
  emailVerifiedAt   DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  userRoles         UserRole[]
  userSessions      UserSession[]
  news              News[]
  communityPosts    CommunityPost[]
  locationReviews   LocationReview[]
  activityLogs      UserActivityLog[]
  pageViews         PageView[]

  @@map("users")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  role      Role
  grantedBy String?
  grantedAt DateTime @default(now())
  expiresAt DateTime?
  isActive  Boolean  @default(true)

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantedByUser User? @relation("RoleGrantedBy", fields: [grantedBy], references: [id])

  @@unique([userId, role])
  @@map("user_roles")
}

model UserSession {
  id              String   @id @default(cuid())
  userId          String
  sessionToken    String   @unique
  refreshToken    String?  @unique
  ipAddress       String?
  userAgent       String?
  deviceInfo      Json?
  isRememberMe    Boolean  @default(false)
  expiresAt       DateTime
  lastActivityAt  DateTime @default(now())
  createdAt       DateTime @default(now())

  // Relations
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityLogs    UserActivityLog[]
  pageViews       PageView[]

  @@map("user_sessions")
}

// Competition Management
model Round {
  id                    String   @id @default(cuid())
  title                 String
  startDateTime         DateTime
  endDateTime           DateTime
  location              String
  address               String
  description           String?
  afterPlayReport       String?
  competitionType       String   @default("Einzelwettbewerb")
  crew                  Json     @default("[]")
  tournamentParticipants Int[]
  groups                Json     @default("[]")
  featureArtists        Json     @default("[]")
  totalJuryMembers      Int      @default(5)
  status                RoundStatus @default(SCHEDULED)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("rounds")
}

// Content Management
model News {
  id                String   @id @default(cuid())
  title             String
  content           String
  excerpt           String?
  authorId          String?
  category          String?
  priority          NewsPriority @default(NORMAL)
  featuredImageUrl  String?
  tags              String[]
  status            NewsStatus @default(DRAFT)
  publishedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  author            User?    @relation(fields: [authorId], references: [id])

  @@map("news")
}

model CommunityPost {
  id            String   @id @default(cuid())
  authorId      String
  content       String
  postType      PostType @default(COMMUNITY)
  parentPostId  String?
  likesCount    Int      @default(0)
  commentsCount Int      @default(0)
  featured      Boolean  @default(false)
  status        PostStatus @default(ACTIVE)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  author        User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentPost    CommunityPost? @relation("PostReplies", fields: [parentPostId], references: [id], onDelete: Cascade)
  replies       CommunityPost[] @relation("PostReplies")

  @@map("community_posts")
}

// City Tips & Recommendations
model CityLocation {
  id              String   @id @default(cuid())
  name            String
  description     String?
  category        LocationCategory
  address         String
  coordinates     Json
  phone           String?
  website         String?
  email           String?
  openingHours    Json?
  priceRange      PriceRange?
  rating          Decimal?
  reviewCount     Int      @default(0)
  tips            String?
  featured        Boolean  @default(false)
  status          LocationStatus @default(ACTIVE)
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  creator         User?    @relation("LocationCreator", fields: [createdBy], references: [id])
  reviews         LocationReview[]

  @@map("city_locations")
}

model LocationReview {
  id          String   @id @default(cuid())
  locationId  String
  userId      String
  rating      Int
  reviewText  String?
  visitDate   DateTime?
  createdAt   DateTime @default(now())

  // Relations
  location    CityLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([locationId, userId])
  @@map("location_reviews")
}

// Analytics & Logging
model UserActivityLog {
  id           String   @id @default(cuid())
  userId       String?
  sessionId    String?
  action       String
  resourceType String?
  resourceId   String?
  ipAddress    String?
  userAgent    String?
  metadata     Json?
  createdAt    DateTime @default(now())

  // Relations
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  session      UserSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@map("user_activity_logs")
}

model PageView {
  id                    String   @id @default(cuid())
  userId                String?
  sessionId             String?
  pagePath              String
  pageTitle             String?
  referrer              String?
  ipAddress             String?
  userAgent             String?
  viewDurationSeconds   Int?
  createdAt             DateTime @default(now())

  // Relations
  user                  User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  session               UserSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@map("page_views")
}

// Enums
enum Role {
  ADMIN
  JURY
  ORGANIZER
  PARTICIPANT
  SPECTATOR
}

enum RoundStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum NewsPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NewsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PostType {
  COMMUNITY
  QUESTION
  ANNOUNCEMENT
}

enum PostStatus {
  ACTIVE
  HIDDEN
  DELETED
}

enum LocationCategory {
  RESTAURANT
  CAFE
  BAR
  CULTURE
  SHOPPING
  HOTEL
  TRANSPORT
}

enum PriceRange {
  EURO_1
  EURO_2
  EURO_3
  EURO_4
}

enum LocationStatus {
  ACTIVE
  INACTIVE
  PENDING
}
