### 2. Hook Architecture Patterns
```javascript
// ✅ APPROPRIATE custom hooks
// Simple, focused hooks with clear responsibilities
const useParticipants = () => {
  return useQuery({
    queryKey: ['participants'],
    queryFn: fetchParticipants,
    staleTime: 5 * 60 * 1000
  });
};

const useLiveData = (entityType) => {
  const [data, setData] = useState(null);
  
  useEffect(() => {
    const handleUpdate = (update) => {
      if (update.type === entityType) {
        setData(update.data);
      }
    };
    
    websocketService.subscribe(entityType, handleUpdate);
    return () => websocketService.unsubscribe(entityType, handleUpdate);
  }, [entityType]);
  
  return data;
};

// ❌ OVER-ENGINEERED hooks
// Complex hooks with too many responsibilities
const useParticipants = () => {
  const [state, dispatch] = useReducer(participantsReducer, initialState);
