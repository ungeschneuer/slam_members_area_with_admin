### 2. Real-time Architecture Patterns
```javascript
// ✅ APPROPRIATE WebSocket usage
// Simple event broadcasting with fallback mechanisms
io.on('connection', (socket) => {
  socket.on('join-room', (room) => {
    socket.join(room);
  });
  
  socket.on('disconnect', () => {
    // Clean up subscriptions
  });
});

const broadcastUpdate = (room, data) => {
  io.to(room).emit('data-update', data);
};

// ❌ OVER-ENGINEERED real-time
// Complex real-time architecture for simple updates
const realtimeEngine = new RealtimeEngine({
  adapters: {
    redis: new RedisAdapter(),
    socketio: new SocketIOAdapter(),
    websocket: new WebSocketAdapter()
  },
  channels: {
    participants: new Channel('participants', {
      permissions: ['read', 'write'],
      rateLimit: { max: 100, window: 60000 }
    })
  }
});
```

### 3. Database Architecture Patterns
```javascript
// ✅ APPROPRIATE database patterns
// Raw SQL with connection pooling and optimized queries
const getParticipantsWithStats = async () => {
  const query = `
    SELECT p.*, COUNT(rp.round_id) as round_count
    FROM participants p
    LEFT JOIN round_participants rp ON p.id = rp.participant_id
    GROUP BY p.id, p.name, p.region, p.pronouns, p.instagram, p.created_at, p.updated_at
    ORDER BY p.name
  `;
  return await executeQuery(query, []);
};

// ❌ OVER-ENGINEERED database
// Complex ORM with advanced features for simple queries
const getParticipantsWithStats = await prisma.participant.findMany({
  include: {
    rounds: {
      include: {
        scores: {
          include: {
            judge: true
          }
        }
      }
    },
    statistics: {
      include: {
        rankings: true,
        achievements: true
      }
    }
  },
  orderBy: {
    name: 'asc'
  }
});
