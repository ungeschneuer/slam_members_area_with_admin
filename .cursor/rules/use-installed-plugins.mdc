## Plugin Usage Patterns

### 1. Express Middleware Stack
```javascript
// ✅ USE established middleware chain
app.use(helmet());                    // Security headers
app.use(cors());                      // CORS handling
app.use(compression());               // Response compression
app.use(morgan('combined'));          // Request logging
app.use(cookieParser());              // Cookie parsing
app.use(express.json());              // JSON parsing
app.use(express.urlencoded({ extended: true })); // Form parsing

// ❌ AVOID custom middleware when plugins exist
app.use(customSecurityMiddleware);
app.use(customCorsHandler);
```

### 2. Database Connection Management
```javascript
// ✅ USE pg Pool (already configured)
import { pool, executeQuery } from '../config/database.js';

const result = await executeQuery('SELECT * FROM users WHERE id = $1', [userId]);

// ❌ AVOID custom connection management
const customConnection = new CustomDBConnection();
```

### 3. React Query Patterns
```javascript
// ✅ USE TanStack Query hooks
const { data: participants, isLoading, error } = useQuery({
  queryKey: ['participants'],
  queryFn: fetchParticipants,
  staleTime: 5 * 60 * 1000
});

// ❌ AVOID custom data fetching
const [participants, setParticipants] = useState([]);
const [loading, setLoading] = useState(false);
useEffect(() => {
  fetchParticipants().then(setParticipants);
}, []);
```

### 4. WebSocket Service
```javascript
// ✅ USE established WebSocket service
import websocketService from '../services/websocketService.js';

websocketService.subscribe('participants', handleUpdate);
websocketService.emit('data-update', data);

// ❌ AVOID custom WebSocket implementations
const customSocket = new WebSocket('ws://localhost:3000');
```

## Helper Functions vs Plugins

### Use Helper Functions for Project-Specific Logic
```javascript
// ✅ APPROPRIATE - Project-specific helpers
import { 
  executeCrudOperation, 
  sendSuccessResponse, 
  normalizeData 
} from '../routes/optimizedRoutes.js';

// ✅ APPROPRIATE - Domain-specific utilities
import { generateSlug, generateUniqueSlug } from '../utils/slugUtils.js';
import { normalizeInstagram } from '../routes/optimizedRoutes.js';
```

### Use Plugins for Generic Functionality
```javascript
// ✅ USE plugins for generic needs
import bcrypt from 'bcrypt';           // Password hashing
import jwt from 'jsonwebtoken';        // JWT tokens
import xss from 'xss';                 // XSS protection
import compression from 'compression'; // Response compression

// ❌ AVOID custom implementations
const customPasswordHash = (password) => { /* custom logic */ };
const customJWT = (payload) => { /* custom logic */ };
```

