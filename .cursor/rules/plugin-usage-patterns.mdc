```

## Build & Development Plugins

### Vite for Build Tooling
```javascript
// ✅ USE Vite configuration
import { defineConfig } from 'vite';
import { plugin as react } from '@vitejs/plugin-react';

export default defineConfig({
  plugins: [react()],
  build: {
    rollupOptions: {
      output: {
        manualChunks: {
          vendor: ['react', 'react-dom']
        }
      }
    }
  }
});

// ❌ AVOID custom build configurations
const customBuildConfig = new CustomBuildConfig();
```

