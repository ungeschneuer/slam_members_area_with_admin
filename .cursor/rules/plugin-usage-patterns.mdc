# Plugin Usage Patterns for SLAM25

## Database & Backend Plugins

### PostgreSQL with pg
```javascript
// ✅ USE pg Pool for database connections
import { Pool } from 'pg';
import { executeQuery } from '../config/database.js';

// ❌ AVOID custom database wrappers
const customDb = new CustomDatabase();
```

### Express.js Middleware Stack
```javascript
// ✅ USE established Express middleware
import express from 'express';
import cors from 'cors';
import helmet from 'helmet';
import compression from 'compression';
import morgan from 'morgan';
import cookieParser from 'cookie-parser';

app.use(helmet());                    // Security headers
app.use(cors());                      // CORS handling
app.use(compression());               // Response compression
app.use(morgan('combined'));          // Request logging
app.use(cookieParser());              // Cookie parsing
```

### Authentication with JWT
```javascript
// ✅ USE jsonwebtoken for authentication
import jwt from 'jsonwebtoken';
import bcrypt from 'bcrypt';

// Token generation
const token = jwt.sign(payload, JWT_SECRET, { expiresIn: '24h' });

// Password hashing
const hashedPassword = await bcrypt.hash(password, 10);
const isValid = await bcrypt.compare(password, hashedPassword);

// ❌ AVOID custom auth implementations
const customToken = generateCustomToken(payload);
```

### Security with helmet and xss
```javascript
// ✅ USE security plugins
import helmet from 'helmet';
import xss from 'xss';

// Security headers
app.use(helmet());

// XSS protection
const cleanInput = xss(userInput);

// ❌ AVOID custom security implementations
const customXSSProtection = sanitizeInput(input);
```

## Frontend & React Plugins

### TanStack Query for State Management
```javascript
// ✅ USE TanStack Query hooks
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query';

// Data fetching
const { data, isLoading, error } = useQuery({
  queryKey: ['participants'],
  queryFn: fetchParticipants,
  staleTime: 5 * 60 * 1000
});

// Mutations
const mutation = useMutation({
  mutationFn: createParticipant,
  onSuccess: () => {
    queryClient.invalidateQueries(['participants']);
  }
});

// ❌ AVOID custom state management
const [data, setData] = useState([]);
const [loading, setLoading] = useState(false);
```

### React Router for Navigation
```javascript
// ✅ USE React Router
import { BrowserRouter, Routes, Route, Link } from 'react-router-dom';

// Routing setup
<BrowserRouter>
  <Routes>
    <Route path="/participants" element={<Participants />} />
    <Route path="/rounds" element={<Rounds />} />
  </Routes>
</BrowserRouter>

// ❌ AVOID custom routing
const customRouter = new CustomRouter();
```

### React Hook Form for Forms
```javascript
// ✅ USE React Hook Form
import { useForm } from 'react-hook-form';
import { zodResolver } from '@hookform/resolvers/zod';
import { z } from 'zod';

// Form validation schema
const schema = z.object({
  name: z.string().min(2),
  email: z.string().email()
});

// Form setup
const { register, handleSubmit, formState: { errors } } = useForm({
  resolver: zodResolver(schema)
});

// ❌ AVOID custom form handling
const [formData, setFormData] = useState({});
const [errors, setErrors] = useState({});
```

## Real-time & WebSocket Plugins

### Socket.io for Real-time Communication
```javascript
// ✅ USE Socket.io
import { io } from 'socket.io-client';
import websocketService from '../services/websocketService.js';

// Connection
websocketService.connect();

// Event handling
websocketService.subscribe('participants', handleUpdate);
websocketService.emit('data-update', data);

// ❌ AVOID custom WebSocket implementations
const socket = new WebSocket('ws://localhost:3000');
```

## Testing Plugins

### Vitest for Testing
```javascript
// ✅ USE Vitest testing framework
import { describe, it, expect, beforeEach } from 'vitest';
import { render, screen } from '@testing-library/react';
import { userEvent } from '@testing-library/user-event';

// Test setup
describe('Component Tests', () => {
  it('should render correctly', () => {
    render(<Component />);
    expect(screen.getByText('Expected Text')).toBeInTheDocument();
  });
});

// ❌ AVOID custom testing frameworks
const customTestRunner = new CustomTestRunner();
```

### Testing Library for React Testing
```javascript
