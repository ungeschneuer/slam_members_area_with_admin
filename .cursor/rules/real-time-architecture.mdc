## Offline Resilience Patterns

### 1. Connection Monitoring
```javascript
// ✅ APPROPRIATE connection monitoring
class WebSocketService {
  setupNetworkListeners() {
    window.addEventListener('online', () => {
      this.networkOnline = true;
      if (!this.isConnected && !this.isConnecting) {
        this.connect();
      }
    });

    window.addEventListener('offline', () => {
      this.networkOnline = false;
      this.offlineMode = true;
    });
  }
  
  handleDisconnection() {
    this.offlineMode = true;
    if (this.reconnectAttempts < this.maxReconnectAttempts) {
      setTimeout(() => {
        this.reconnectAttempts++;
        this.connect();
      }, this.reconnectDelay * this.reconnectAttempts);
    }
  }
}

// ❌ OVER-ENGINEERED connection monitoring
class WebSocketService {
  setupConnectionMonitoring() {
    this.healthChecker = new HealthChecker({
      interval: 5000,
      timeout: 10000,
      retries: 3,
      backoff: new ExponentialBackoffStrategy(),
      circuitBreaker: new CircuitBreaker({
        failureThreshold: 5,
        recoveryTimeout: 30000
      })
    });
  }
}
```

### 2. Fallback Mechanisms
```javascript
// ✅ APPROPRIATE fallback mechanisms
const fetchDataWithFallback = async (queryFn, fallbackFn) => {
  try {
    if (websocketService.isConnected) {
      return await queryFn();
    } else {
      return await fallbackFn();
    }
  } catch (error) {
    console.warn('WebSocket unavailable, using fallback:', error);
    return await fallbackFn();
  }
};

// ❌ OVER-ENGINEERED fallback mechanisms
const fetchDataWithFallback = async (queryFn, fallbackFn) => {
  const strategy = new FallbackStrategy({
    primary: queryFn,
    fallback: fallbackFn,
    retryPolicy: new RetryPolicy({
      maxAttempts: 3,
      backoff: new ExponentialBackoffStrategy()
    }),
    circuitBreaker: new CircuitBreaker({
      failureThreshold: 5,
      recoveryTimeout: 30000
    })
  });
  
  return await strategy.execute();
};
```

## Performance Optimization Patterns

### 1. Message Batching
```javascript
// ✅ APPROPRIATE message batching
class WebSocketService {
  constructor() {
    this.messageQueue = [];
    this.batchSize = 10;
    this.batchTimeout = 100; // 100ms
  }
  
  queueMessage(message) {
    this.messageQueue.push(message);
    
    if (this.messageQueue.length >= this.batchSize) {
      this.flushMessages();
    } else {
      setTimeout(() => this.flushMessages(), this.batchTimeout);
    }
  }
  
  flushMessages() {
    if (this.messageQueue.length > 0) {
      this.socket.emit('batch-update', this.messageQueue);
      this.messageQueue = [];
    }
  }
}

// ❌ OVER-ENGINEERED message batching
class WebSocketService {
  constructor() {
    this.messageProcessor = new MessageProcessor({
      batching: new BatchingStrategy({
        size: 10,
        timeout: 100,
        compression: true
      }),
      queuing: new QueueStrategy({
        maxSize: 1000,
        overflow: 'drop-oldest'
      }),
      serialization: new JSONSerializationStrategy()
    });
  }
}
```

### 2. Connection Pooling
```javascript
// ✅ APPROPRIATE connection management
class WebSocketService {
  constructor() {
    this.connectionPool = new Map();
    this.maxConnections = 5;
  }
  
  getConnection(room) {
    if (this.connectionPool.has(room)) {
      return this.connectionPool.get(room);
    }
    
    if (this.connectionPool.size >= this.maxConnections) {
      const oldestRoom = this.connectionPool.keys().next().value;
      this.connectionPool.delete(oldestRoom);
    }
    
    const connection = this.createConnection(room);
    this.connectionPool.set(room, connection);
    return connection;
  }
}

// ❌ OVER-ENGINEERED connection pooling
class WebSocketService {
  constructor() {
    this.connectionPool = new ConnectionPool({
      maxSize: 100,
      evictionPolicy: 'LRU',
      healthCheck: new HealthCheckStrategy({
        interval: 30000,
        timeout: 5000
      }),
      loadBalancing: new RoundRobinStrategy(),
      failover: new FailoverStrategy({
        maxFailures: 3,
        recoveryTimeout: 60000
      })
    });
  }
}
```

## Security Patterns

### 1. Authentication Integration
```javascript
// ✅ APPROPRIATE authentication
io.use((socket, next) => {
  const token = socket.handshake.auth.token;
  if (!token) {
    return next(new Error('Authentication error'));
  }
  
  try {
    const decoded = jwt.verify(token, process.env.JWT_SECRET);
    socket.userId = decoded.id;
    socket.userRole = decoded.role;
    next();
  } catch (error) {
    next(new Error('Invalid token'));
  }
});

io.on('connection', (socket) => {
  socket.on('join-admin', () => {
    if (socket.userRole === 'admin') {
      socket.join('admin');
    }
  });
});

// ❌ OVER-ENGINEERED authentication
io.use(new AuthMiddleware({
  strategies: [
    new JWTAuthStrategy({
      secret: process.env.JWT_SECRET,
      algorithms: ['HS256']
    }),
    new SessionAuthStrategy({
      store: new RedisStore({
        host: process.env.REDIS_HOST,
        port: process.env.REDIS_PORT
      })
    })
  ],
  fallback: new AnonymousAuthStrategy()
}));
```

### 2. Rate Limiting
```javascript
// ✅ APPROPRIATE rate limiting
const rateLimitMap = new Map();

io.on('connection', (socket) => {
  socket.on('data-update', (data) => {
    const userId = socket.userId;
    const now = Date.now();
    const userLimits = rateLimitMap.get(userId) || { count: 0, resetTime: now + 60000 };
    
    if (now > userLimits.resetTime) {
      userLimits.count = 0;
      userLimits.resetTime = now + 60000;
    }
    
    if (userLimits.count >= 100) {
      socket.emit('rate-limit-exceeded');
      return;
    }
    
    userLimits.count++;
    rateLimitMap.set(userId, userLimits);
    
    // Process update
    broadcastUpdate('participants', data);
  });
});

// ❌ OVER-ENGINEERED rate limiting
const rateLimiter = new RateLimiter({
  windowMs: 60000,
  max: 100,
  keyGenerator: (socket) => socket.userId,
  skip: (socket) => socket.userRole === 'admin',
  onLimitReached: (socket) => {
    socket.emit('rate-limit-exceeded');
  },
  standardHeaders: true,
  legacyHeaders: false
});
```

