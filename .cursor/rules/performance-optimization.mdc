## API Performance Patterns

### 1. Response Optimization
```javascript
// ✅ OPTIMIZED API responses
router.get('/participants', async (req, res) => {
  try {
    const startTime = startTiming();
    const participants = await optimizedQueryService.getParticipantsWithStats();
    const duration = endTiming(startTime);
    
    sendSuccessResponse(res, participants, 'GET_PARTICIPANTS', duration);
  } catch (error) {
    sendErrorResponse(res, error, 'Failed to fetch participants');
  }
});

// ❌ INEFFICIENT API responses
router.get('/participants', async (req, res) => {
  try {
    const participants = await executeQuery('SELECT * FROM participants', []);
    const stats = await Promise.all(
      participants.rows.map(async (participant) => {
        const count = await executeQuery(
          'SELECT COUNT(*) FROM round_participants WHERE participant_id = $1',
          [participant.id]
        );
        return { ...participant, round_count: count.rows[0].count };
      })
    );
    
    res.json({ success: true, data: stats });
  } catch (error) {
    res.status(500).json({ success: false, error: error.message });
  }
});
```

### 2. Request Optimization
```javascript
// ✅ OPTIMIZED request handling
router.get('/participants', async (req, res) => {
  try {
    const { limit, offset, search } = extractQueryParams(req, { 
      limit: 50, 
      offset: 0 
    });
    
    const startTime = startTiming();
    const participants = await optimizedQueryService.getParticipantsWithStats(limit, offset, search);
    const duration = endTiming(startTime);
    
    sendSuccessResponse(res, participants, 'GET_PARTICIPANTS', duration);
  } catch (error) {
    sendErrorResponse(res, error, 'Failed to fetch participants');
  }
});

// ❌ INEFFICIENT request handling
router.get('/participants', async (req, res) => {
  try {
    const limit = parseInt(req.query.limit) || 50;
    const offset = parseInt(req.query.offset) || 0;
    const search = req.query.search || '';
    
    const participants = await executeQuery(
      'SELECT * FROM participants WHERE name ILIKE $1 LIMIT $2 OFFSET $3',
      [`%${search}%`, limit, offset]
    );
    
    res.json({ success: true, data: participants.rows });
  } catch (error) {
    res.status(500).json({ success: false, error: error.message });
  }
});
```

## Real-time Performance Patterns

### 1. WebSocket Optimization
```javascript
// ✅ OPTIMIZED WebSocket usage
const broadcastUpdate = (room, data) => {
  io.to(room).emit('data-update', {
    type: 'participants',
    data: data,
    timestamp: Date.now()
  });
};

const notifyDataUpdate = (entityType) => {
  // Clear cache
  cache.delete(`cache:${entityType}`);
  
  // Broadcast update
  io.emit('data-update', { 
    type: entityType, 
    timestamp: Date.now() 
  });
};

// ❌ OVER-ENGINEERED WebSocket usage
const realtimeEngine = new RealtimeEngine({
  adapters: {
    redis: new RedisAdapter(),
    socketio: new SocketIOAdapter(),
    websocket: new WebSocketAdapter()
  },
  channels: {
    participants: new Channel('participants', {
      permissions: ['read', 'write'],
      rateLimit: { max: 100, window: 60000 },
      persistence: true,
      compression: true
    })
  },
  middleware: [
    new AuthMiddleware(),
    new RateLimitMiddleware(),
    new ValidationMiddleware()
  ]
});
```

### 2. Message Batching
```javascript
// ✅ APPROPRIATE message batching
class WebSocketService {
  constructor() {
    this.messageQueue = [];
    this.batchSize = 10;
    this.batchTimeout = 100; // 100ms
  }
  
  queueMessage(message) {
    this.messageQueue.push(message);
    
    if (this.messageQueue.length >= this.batchSize) {
      this.flushMessages();
    } else {
      setTimeout(() => this.flushMessages(), this.batchTimeout);
    }
  }
  
  flushMessages() {
    if (this.messageQueue.length > 0) {
      this.socket.emit('batch-update', this.messageQueue);
      this.messageQueue = [];
    }
  }
}

// ❌ OVER-ENGINEERED message batching
class WebSocketService {
  constructor() {
    this.messageProcessor = new MessageProcessor({
      batching: new BatchingStrategy({
        size: 10,
        timeout: 100,
        compression: true
      }),
      queuing: new QueueStrategy({
        maxSize: 1000,
        overflow: 'drop-oldest'
      }),
      serialization: new JSONSerializationStrategy()
    });
  }
}
```

## Monitoring Performance Patterns

### 1. Performance Metrics
```javascript
// ✅ APPROPRIATE performance monitoring
const trackPerformance = (operation, duration) => {
  logger.info('Operation completed', {
    operation,
    duration: `${Math.round(duration)}ms`,
    timestamp: new Date().toISOString()
  });
};

const executeQuery = async (query, params) => {
  const startTime = startTiming();
  
  try {
    const result = await pool.query(query, params);
    const duration = endTiming(startTime);
    
    trackPerformance('DATABASE_QUERY', duration);
    return result;
  } catch (error) {
    const duration = endTiming(startTime);
    logger.error('Query failed', {
      query: query.substring(0, 100) + '...',
      duration: `${Math.round(duration)}ms`,
      error: error.message
    });
    throw error;
  }
};

// ❌ OVER-ENGINEERED monitoring
const observability = {
  metrics: new PrometheusMetrics({
    collectDefaultMetrics: true,
    timeout: 5000,
    gcDurationBuckets: [0.001, 0.01, 0.1, 1, 2, 5]
  }),
  tracing: new JaegerTracer({
    serviceName: 'slam25-api',
    sampler: new ConstSampler(true),
    reporter: new RemoteReporter({
      channel: new HttpChannel({
        url: 'http://jaeger:14268/api/traces'
      })
    })
  }),
  logging: new ELKStack({
    elasticsearch: { host: 'elasticsearch:9200' },
    kibana: { host: 'kibana:5601' },
    logstash: { host: 'logstash:5044' }
  })
};
```

### 2. Error Monitoring
```javascript
// ✅ APPROPRIATE error monitoring
const handleError = (error, req, res) => {
  logger.error('API Error', {
    error: error.message,
    stack: error.stack,
    url: req.url,
    method: req.method,
    timestamp: new Date().toISOString()
  });
  
  sendErrorResponse(res, error, 'An error occurred');
};

// ❌ OVER-ENGINEERED error monitoring
const errorTracker = new ErrorTracker({
  providers: [
    new SentryProvider({
      dsn: process.env.SENTRY_DSN,
      environment: process.env.NODE_ENV,
      release: process.env.RELEASE
    }),
    new BugsnagProvider({
      apiKey: process.env.BUGSNAG_API_KEY,
      releaseStage: process.env.NODE_ENV
    })
  ],
  filters: [
    new ErrorFilter({ minLevel: 'error' }),
    new RateLimitFilter({ maxPerMinute: 100 })
  ]
});
```

## Memory Management Patterns

### 1. Frontend Memory
```javascript
// ✅ APPROPRIATE memory management
useEffect(() => {
  const interval = setInterval(() => {
    // Update data
  }, 30000);
  
  return () => clearInterval(interval);
}, []);

useEffect(() => {
  const subscription = websocketService.subscribe('participants', handleUpdate);
  
  return () => subscription.unsubscribe();
}, []);

// ❌ MEMORY LEAKS
useEffect(() => {
  const interval = setInterval(() => {
    // Update data
  }, 30000);
  
  // Missing cleanup
}, []);
```

### 2. Backend Memory
```javascript
// ✅ APPROPRIATE memory management
const cache = new Map();
const MAX_CACHE_SIZE = 1000;

const setCachedData = (key, data) => {
  if (cache.size >= MAX_CACHE_SIZE) {
    const firstKey = cache.keys().next().value;
    cache.delete(firstKey);
  }
  cache.set(key, data);
};

// ❌ MEMORY LEAKS
const cache = new Map();
const setCachedData = (key, data) => {
  cache.set(key, data); // No size limit
};
```

## Performance Anti-Patterns

### ❌ Over-Optimization
- Complex caching for small datasets
- Database query optimization for simple queries
- Advanced state management for simple UI
- Complex real-time architecture for basic updates

### ❌ Under-Optimization
- No caching for frequently accessed data
- N+1 database queries
- Large bundle sizes
- No performance monitoring
- No error handling

## Scale-Appropriate Performance Patterns

### ✅ Right-Sized Solutions
- Simple in-memory caching with TTL
- Basic performance monitoring and logging
- Appropriate database indexing
- Simple WebSocket broadcasting
- Focused component architecture
- Essential performance optimizations only

## Remember: Optimize for the actual scale and requirements, not theoretical maximums or over-engineering patterns.