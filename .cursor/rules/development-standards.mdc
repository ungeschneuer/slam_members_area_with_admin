# Development Standards & Code Quality

## Code Organization Principles

### 1. File Structure Standards
```
client/
  components/          # React components
    admin/            # Admin-specific components
    __tests__/        # Component tests
  hooks/              # Custom React hooks
  services/           # API and utility services
  utils/              # Utility functions
server/
  routes/             # API route handlers
  services/           # Business logic services
  middleware/          # Express middleware
  config/             # Configuration files
database/
  schema.sql          # Database schema
  migrations/         # Database migrations
```

### 2. Naming Conventions
```javascript
// ✅ GOOD naming
const ParticipantCard = ({ participant }) => { /* ... */ };
const useParticipants = () => { /* ... */ };
const getParticipantsWithStats = async () => { /* ... */ };
const sendSuccessResponse = (res, data, type) => { /* ... */ };

// ❌ BAD naming
const PC = ({ p }) => { /* ... */ };
const useP = () => { /* ... */ };
const getPWS = async () => { /* ... */ };
const sSR = (res, data, type) => { /* ... */ };
```

### 3. Component Architecture Standards
```javascript
// ✅ APPROPRIATE component structure
const ParticipantCard = ({ participant, onSelect, className = '' }) => {
  const [isExpanded, setIsExpanded] = useState(false);
  
  const handleClick = () => {
    onSelect?.(participant);
  };
  
  return (
    <div className={`participant-card ${className}`} onClick={handleClick}>
      <h3>{participant.name}</h3>
      <p>{participant.region}</p>
      {isExpanded && (
        <div className="participant-details">
          <p>{participant.pronouns}</p>
          <p>{participant.instagram}</p>
        </div>
      )}
    </div>
  );
};

// ❌ OVER-ENGINEERED component
const ParticipantCard = ({ participant, onSelect, onEdit, onDelete, showStats, showActions, className, theme, size, variant, ...props }) => {
  const [state, dispatch] = useReducer(complexReducer, initialState);
  const { data, loading, error } = useQuery(complexQuery);
  const [isExpanded, setIsExpanded] = useState(false);
  const [isLoading, setIsLoading] = useState(false);
  const [error, setError] = useState(null);
  
  // ... 100+ lines of complex logic
};
```

## API Development Standards

### 1. Route Handler Patterns
```javascript
// ✅ STANDARD route pattern
router.get('/participants', async (req, res) => {
  try {
    const startTime = startTiming();
    const participants = await optimizedQueryService.getParticipantsWithStats();
    const duration = endTiming(startTime);
    
    sendSuccessResponse(res, participants, 'GET_PARTICIPANTS', duration);
  } catch (error) {
    sendErrorResponse(res, error, 'Failed to fetch participants');
  }
});

router.post('/participants', ...adminMiddleware(), async (req, res) => {
  const normalizedData = normalizeData(req.body, {
    name: { type: 'string', fallback: '' },
    region: { type: 'string', fallback: '' },
    pronouns: { type: 'string', fallback: '' },
    instagram: { type: 'string', fallback: '' }
  });
  
  await executeCrudOperation(
    'create',
    'INSERT INTO participants (name, region, pronouns, instagram) VALUES ($1, $2, $3, $4) RETURNING *',
    [normalizedData.name, normalizedData.region, normalizedData.pronouns, normalizedData.instagram],
    'participant',
    'CREATE_PARTICIPANT',
    res
  );
});

// ❌ INCONSISTENT route pattern
router.get('/participants', async (req, res) => {
  const participants = await getParticipants();
  res.json({ success: true, data: participants });
});

router.post('/participants', authenticateCookie, authorizeCookie(['admin']), async (req, res) => {
  const { name, region, pronouns, instagram } = req.body;
  const result = await executeQuery(
    'INSERT INTO participants (name, region, pronouns, instagram) VALUES ($1, $2, $3, $4) RETURNING *',
    [name, region, pronouns, instagram]
  );
  res.status(201).json({ success: true, data: result.rows[0] });
});
```

### 2. Error Handling Standards
```javascript
// ✅ STANDARDIZED error handling
try {
  const result = await executeQuery(query, params);
  sendSuccessResponse(res, result.rows[0], 'OPERATION_TYPE', duration);
} catch (error) {
  sendErrorResponse(res, error, 'Operation failed');
}

// ❌ MANUAL error handling
try {
  const result = await executeQuery(query, params);
  res.status(200).json({ success: true, data: result.rows[0] });
} catch (error) {
  logger.error('Error:', error);
  res.status(500).json({ success: false, error: 'Operation failed' });
}
```

### 3. Response Format Standards
```javascript
// ✅ STANDARDIZED response format
{
  success: true,
  data: result,
  meta: {
    queryType: 'OPERATION_TYPE',
    duration: '123ms'
  }
}

// ❌ INCONSISTENT response format
{
  success: true,
  participants: result,
  timestamp: Date.now()
}
```

## Database Development Standards

### 1. Query Patterns
```javascript
// ✅ APPROPRIATE query patterns
// Use parameterized queries for security
const getParticipants = async () => {
  const query = 'SELECT * FROM participants ORDER BY name';
  const result = await executeQuery(query, []);
  return result.rows;
};

const getParticipantById = async (id) => {
  const query = 'SELECT * FROM participants WHERE id = $1';
  const result = await executeQuery(query, [id]);
  return result.rows[0];
};

// ❌ INSECURE query patterns
// Direct string concatenation (SQL injection risk)
const getParticipantById = async (id) => {
  const query = `SELECT * FROM participants WHERE id = ${id}`;
  const result = await executeQuery(query, []);
  return result.rows[0];
};
```

### 2. Performance Monitoring
```javascript
// ✅ ALWAYS include performance timing
const startTime = startTiming();
const result = await executeQuery(query, params);
const duration = endTiming(startTime);

logger.info('Operation completed', {
  operation: 'CREATE_ENTITY',
  duration: `${Math.round(duration)}ms`,
  recordCount: result.rows.length
});

// ❌ NO performance monitoring
const result = await executeQuery(query, params);
```

## Frontend Development Standards

### 1. Hook Usage Patterns
```javascript
// ✅ APPROPRIATE hook usage
const useParticipants = () => {
  return useQuery({
    queryKey: ['participants'],
    queryFn: fetchParticipants,
    staleTime: 5 * 60 * 1000,
    cacheTime: 10 * 60 * 1000
  });
};

const ParticipantList = () => {
  const { data: participants, isLoading, error } = useParticipants();
  const [searchTerm, setSearchTerm] = useState('');
  
  if (isLoading) return <LoadingSpinner />;
  if (error) return <ErrorMessage error={error} />;
  
  return (
    <div>
      <input 
        value={searchTerm}
        onChange={(e) => setSearchTerm(e.target.value)}
        placeholder="Search participants..."
      />
      {participants?.map(participant => (
        <ParticipantCard key={participant.id} participant={participant} />
      ))}
    </div>
  );
};

// ❌ OVER-ENGINEERED hook usage
const useParticipants = () => {
  const [state, dispatch] = useReducer(participantsReducer, initialState);
  const { data, loading, error } = useQuery(complexQuery);
  
  useEffect(() => {
    if (data) {
      dispatch({ type: 'SET_PARTICIPANTS', payload: data });
    }
  }, [data]);
  
  useEffect(() => {
    if (error) {
      dispatch({ type: 'SET_ERROR', payload: error });
    }
  }, [error]);
  
  // ... 50+ lines of complex state management
};
```

### 2. Component Performance
```javascript
// ✅ APPROPRIATE performance optimizations
const MemoizedParticipantCard = React.memo(ParticipantCard);
const LazyAdminPanel = React.lazy(() => import('./AdminPanel'));

// ❌ PREMATURE optimizations
