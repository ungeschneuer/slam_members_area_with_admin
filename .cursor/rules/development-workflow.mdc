## Common Patterns

### CRUD Operations
```javascript
// Create
router.post('/entity', ...adminMiddleware(), async (req, res) => {
  const normalizedData = normalizeData(req.body, schema);
  await executeCrudOperation('create', query, params, 'entity', 'CREATE_ENTITY', res);
});

// Update
router.put('/entity/:id', ...adminMiddleware(), async (req, res) => {
  const normalizedData = normalizeData(req.body, schema);
  await executeCrudOperation('update', query, params, 'entity', 'UPDATE_ENTITY', res);
});

// Delete
router.delete('/entity/:id', ...adminMiddleware(), async (req, res) => {
  await executeCrudOperation('delete', query, [safeParseInt(req.params.id)], 'entity', 'DELETE_ENTITY', res);
});
```

### Query with Parameters
```javascript
router.get('/entity', async (req, res) => {
  try {
    const { limit, offset } = extractQueryParams(req, { limit: 50, offset: 0 });
    const startTime = startTiming();
    const entities = await optimizedQueryService.getEntities(limit, offset);
    const duration = endTiming(startTime);
    sendSuccessResponse(res, entities, 'GET_ENTITIES', duration);
  } catch (error) {
    sendErrorResponse(res, error, 'Failed to fetch entities');
  }
});
```