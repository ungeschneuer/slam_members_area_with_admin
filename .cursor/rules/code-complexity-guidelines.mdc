    dispatch({ type: 'SET_FILTERS', payload: filters });
  };
  
  // ... 100+ more lines of complex state management
};
```

## Backend Complexity Guidelines

### Function Complexity
```javascript
// ✅ APPROPRIATE function complexity
// Simple, focused function
const getParticipants = async () => {
  const query = 'SELECT * FROM participants ORDER BY name';
  const result = await executeQuery(query, []);
  return result.rows;
};

// ❌ OVER-COMPLEX function
// Too many responsibilities
const getParticipants = async (options = {}) => {
  const {
    search = '',
    sortBy = 'name',
    sortOrder = 'asc',
    filters = {},
    page = 1,
    limit = 10,
    includeStats = false,
    includeRounds = false,
    includeScores = false,
    includeRankings = false
  } = options;
  
  let query = 'SELECT p.*';
  let joins = [];
  let whereConditions = [];
  let params = [];
  
  if (includeStats) {
    query += ', COUNT(rp.round_id) as round_count';
    joins.push('LEFT JOIN round_participants rp ON p.id = rp.participant_id');
  }
  
  if (includeRounds) {
    query += ', r.title as round_title, r.date as round_date';
    joins.push('LEFT JOIN rounds r ON rp.round_id = r.id');
  }
  
  if (includeScores) {
    query += ', s.score, s.judge_id';
    joins.push('LEFT JOIN scores s ON rp.id = s.round_participant_id');
  }
  
  if (includeRankings) {
    query += ', ROW_NUMBER() OVER (ORDER BY s.score DESC) as ranking';
  }
  
  if (search) {
    whereConditions.push('(p.name ILIKE $' + (params.length + 1) + ' OR p.region ILIKE $' + (params.length + 1) + ')');
    params.push(`%${search}%`);
  }
  
  if (filters.region) {
    whereConditions.push('p.region = $' + (params.length + 1));
    params.push(filters.region);
  }
  
  if (filters.pronouns) {
    whereConditions.push('p.pronouns = $' + (params.length + 1));
    params.push(filters.pronouns);
  }
  
  if (filters.dateFrom) {
    whereConditions.push('p.created_at >= $' + (params.length + 1));
    params.push(filters.dateFrom);
  }
  
  if (filters.dateTo) {
    whereConditions.push('p.created_at <= $' + (params.length + 1));
    params.push(filters.dateTo);
  }
  
  query += ' FROM participants p';
  query += joins.join(' ');
  
  if (whereConditions.length > 0) {
    query += ' WHERE ' + whereConditions.join(' AND ');
  }
  
  query += ' GROUP BY p.id';
  
  if (includeRankings) {
    query += ' ORDER BY ranking';
  } else {
    query += ` ORDER BY p.${sortBy} ${sortOrder.toUpperCase()}`;
  }
  
  query += ` LIMIT $${params.length + 1} OFFSET $${params.length + 2}`;
  params.push(limit, (page - 1) * limit);
  
  const result = await executeQuery(query, params);
  return result.rows;
};
```

### Route Complexity
