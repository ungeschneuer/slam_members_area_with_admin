// ✅ APPROPRIATE route complexity
// Simple, focused route
router.get('/participants', async (req, res) => {
  try {
    const participants = await getParticipants();
    sendSuccessResponse(res, participants, 'GET_PARTICIPANTS');
  } catch (error) {
    sendErrorResponse(res, error, 'Failed to fetch participants');
  }
});

// ❌ OVER-COMPLEX route
// Too many responsibilities
router.get('/participants', async (req, res) => {
  try {
    const {
      search = '',
      sortBy = 'name',
      sortOrder = 'asc',
      filters = {},
      page = 1,
      limit = 10,
      includeStats = false,
      includeRounds = false,
      includeScores = false,
      includeRankings = false
    } = req.query;
    
    // Validate parameters
    if (sortBy && !['name', 'region', 'created_at'].includes(sortBy)) {
      return res.status(400).json({ error: 'Invalid sortBy parameter' });
    }
    
    if (sortOrder && !['asc', 'desc'].includes(sortOrder)) {
      return res.status(400).json({ error: 'Invalid sortOrder parameter' });
    }
    
    if (page < 1) {
      return res.status(400).json({ error: 'Page must be greater than 0' });
    }
    
    if (limit < 1 || limit > 100) {
      return res.status(400).json({ error: 'Limit must be between 1 and 100' });
    }
    
    // Check cache
    const cacheKey = `participants:${JSON.stringify(req.query)}`;
    const cached = cache.get(cacheKey);
    if (cached) {
      return res.json({
        success: true,
        data: cached.data,
        meta: {
          queryType: 'GET_PARTICIPANTS',
          duration: '0ms',
          cached: true
        }
      });
    }
    
    // Build query
    let query = 'SELECT p.*';
    let joins = [];
    let whereConditions = [];
    let params = [];
    
    if (includeStats) {
      query += ', COUNT(rp.round_id) as round_count';
      joins.push('LEFT JOIN round_participants rp ON p.id = rp.participant_id');
    }
    
    // ... 100+ more lines of complex query building
    
    const startTime = startTiming();
    const result = await executeQuery(query, params);
    const duration = endTiming(startTime);
    
    // Cache result
    cache.set(cacheKey, { data: result.rows }, 300000);
    
    // Log performance
    logger.info('Participants fetched', {
      queryType: 'GET_PARTICIPANTS',
      duration: `${Math.round(duration)}ms`,
      recordCount: result.rows.length
    });
    
    res.json({
      success: true,
      data: result.rows,
      meta: {
        queryType: 'GET_PARTICIPANTS',
        duration: `${Math.round(duration)}ms`,
        cached: false
      }
    });
  } catch (error) {
    logger.error('Error fetching participants', error);
    res.status(500).json({
      success: false,
      error: 'Failed to fetch participants'
    });
  }
});
```

### Service Complexity
```javascript
// ✅ APPROPRIATE service complexity
// Simple, focused service
const participantService = {
  async getParticipants() {
    const query = 'SELECT * FROM participants ORDER BY name';
    const result = await executeQuery(query, []);
    return result.rows;
  },
  
  async createParticipant(data) {
    const query = 'INSERT INTO participants (name, region, pronouns) VALUES ($1, $2, $3) RETURNING *';
    const result = await executeQuery(query, [data.name, data.region, data.pronouns]);
    return result.rows[0];
  }
};

// ❌ OVER-COMPLEX service
// Too many responsibilities
class ParticipantService {
  constructor(database, cache, logger, metrics, validator, transformer) {
    this.database = database;
    this.cache = cache;
    this.logger = logger;
    this.metrics = metrics;
    this.validator = validator;
    this.transformer = transformer;
  }
  
  async getParticipants(options = {}) {
    const {
      search = '',
      sortBy = 'name',
      sortOrder = 'asc',
      filters = {},
      page = 1,
      limit = 10,
      includeStats = false,
      includeRounds = false,
      includeScores = false,
      includeRankings = false
    } = options;
    
    // Validate options
    const validationResult = this.validator.validateGetParticipantsOptions(options);
    if (!validationResult.isValid) {
      throw new ValidationError(validationResult.errors);
    }
    
    // Check cache
    const cacheKey = this.generateCacheKey('participants', options);
    const cached = await this.cache.get(cacheKey);
    if (cached) {
      this.metrics.increment('cache.hit');
      return cached;
    }
    
    this.metrics.increment('cache.miss');
    
    // Build query
    const queryBuilder = new QueryBuilder()
      .select('p.*')
      .from('participants p');
    
    if (includeStats) {
      queryBuilder.select('COUNT(rp.round_id) as round_count');
      queryBuilder.leftJoin('round_participants rp', 'p.id = rp.participant_id');
    }
    
    if (includeRounds) {
      queryBuilder.select('r.title as round_title, r.date as round_date');
      queryBuilder.leftJoin('rounds r', 'rp.round_id = r.id');
    }
    
    if (includeScores) {
      queryBuilder.select('s.score, s.judge_id');
      queryBuilder.leftJoin('scores s', 'rp.id = s.round_participant_id');
    }
    
    if (includeRankings) {
      queryBuilder.select('ROW_NUMBER() OVER (ORDER BY s.score DESC) as ranking');
    }
    
    // Apply filters
    if (search) {
      queryBuilder.where('(p.name ILIKE ? OR p.region ILIKE ?)', [`%${search}%`, `%${search}%`]);
    }
    
    if (filters.region) {
      queryBuilder.where('p.region = ?', [filters.region]);
    }
    
    if (filters.pronouns) {
      queryBuilder.where('p.pronouns = ?', [filters.pronouns]);
    }
    
    if (filters.dateFrom) {
      queryBuilder.where('p.created_at >= ?', [filters.dateFrom]);
    }
    
    if (filters.dateTo) {
      queryBuilder.where('p.created_at <= ?', [filters.dateTo]);
    }
    
    // Apply sorting
    if (includeRankings) {
      queryBuilder.orderBy('ranking');
    } else {
      queryBuilder.orderBy(`p.${sortBy}`, sortOrder);
    }
    
    // Apply pagination
    queryBuilder.limit(limit).offset((page - 1) * limit);
    
    const query = queryBuilder.build();
    const params = queryBuilder.getParams();
    
    const startTime = startTiming();
    const result = await this.database.query(query, params);
    const duration = endTiming(startTime);
    
    // Transform data
    const transformedData = this.transformer.transformParticipants(result.rows);
    
    // Cache result
    await this.cache.set(cacheKey, transformedData, 300000);
    
    // Log performance
    this.logger.info('Participants fetched', {
      queryType: 'GET_PARTICIPANTS',
      duration: `${Math.round(duration)}ms`,
      recordCount: result.rows.length
    });
    
    this.metrics.histogram('participants.fetch.duration', duration);
    this.metrics.counter('participants.fetch.count').inc();
    
    return transformedData;
  }
}
```

## Complexity Anti-Patterns

### ❌ Over-Complexity
- Functions with too many responsibilities
- Components with too many props
- Complex state management for simple data
- Over-engineered service layers
- Complex routing for simple navigation

### ❌ Under-Complexity
- No error handling
- No input validation
- No performance monitoring
- No testing
- No security considerations

## Complexity Guidelines

### ✅ Right-Sized Complexity
- Functions with single responsibility
- Components with focused purpose
- Simple state management
- Basic error handling and validation
- Appropriate testing coverage
- Security considerations

### Complexity Metrics
- **Cyclomatic Complexity**: < 5 per function
- **Function Length**: < 50 lines per function
- **Component Size**: < 200 lines per component
- **File Size**: < 500 lines per file
- **Nesting Depth**: < 4 levels

## Remember: Choose complexity that matches the actual requirements and scale, not theoretical maximums or over-engineering patterns.